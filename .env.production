# Baked into the client bundle by `next build` (this is a static export, so
# NEXT_PUBLIC_* values are inlined at build time — a Fly runtime secret cannot
# reach them). Not a secret: the URL ships inside the page's JavaScript either
# way, and the Apps Script rejects anything without a name and a signature.
NEXT_PUBLIC_WAIVER_ENDPOINT=https://script.google.com/macros/s/AKfycbwa_7e-ob9k5LLvE9P0Aq4BwMnY-Hqp2p-VCiSjLKBMwsmp2cUODJDxR9AYoWoUvnKh/exec
